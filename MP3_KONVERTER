import os
import torchaudio
import soundfile as sf
import pandas as pd

# Verzeichnis, in das die konvertierten WAV-Dateien gespeichert werden sollen
mp3_directory = 'C:/AI_Datasets/fma_medium/fma_medium'
wav_directory = 'C:/AI_Datasets/fma_medium/fma_medium/wav'
log_file = 'C:/AI_Datasets/fma_medium/fma_medium/convert_log.txt'

# Erstellen des Zielverzeichnisses, wenn es noch nicht existiert
os.makedirs(wav_directory, exist_ok=True)

# Pfad zur Annotationsdatei
annotations_file = 'C:/AI_Datasets/Tracks_Medium.csv'

# Lade Annotationsdatei
annotations = pd.read_csv(annotations_file, delimiter=';')  # Semikolon als Trennzeichen anpassen

# Öffnen des Log-Files im Append-Modus
with open(log_file, 'a') as log_handle:

    # Schleife über alle Zeilen in den Annotationsdaten
    for index, row in annotations.iterrows():
        # Extrahiere den Dateinamen aus der entsprechenden Spalte der Zeile
        filenum = row['Filename']  # Hier musst du den Namen der Spalte anpassen, die den Dateinamen enthält
        filename = str(filenum).zfill(10)
        segment_folder = str(filename)[:3]
        # Konstruieren des vollständigen Pfads zur MP3-Datei
        mp3_path = os.path.join(mp3_directory, segment_folder, filename)
        # Konstruieren des vollständigen Pfads zur Ziel-WAV-Datei
        wav_path = os.path.join(wav_directory, filename[:-4] + '.wav')

        # Überprüfen, ob die WAV-Datei bereits existiert
        if os.path.exists(wav_path):
            print(f"WAV-Datei {wav_path} existiert bereits, überspringe Konvertierung.")
            continue

        try:
            # MP3 in WAV konvertieren
            audio_data, sample_rate = torchaudio.load(mp3_path)
            sf.write(wav_path, audio_data[0].numpy(), sample_rate)
            print(f"Schreibe {(filename[:-4] + '.wav')} in {wav_path}")
        except Exception as e:
            # Schreibe die Ausnahmeinformationen in das Log-File
            error_msg = f"Fehler beim Laden von {mp3_path}: {e}\n"
            log_handle.write(error_msg)
            print(error_msg)
